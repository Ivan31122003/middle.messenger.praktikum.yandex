<div class="pr-avatar">
  {{#if isChangeable}}
    <div class="pr-avatar__overlay">
      <span>Поменять аватар</span>
    </div>
  {{/if}}

  {{#if avatar}}
    <img
      src="https://ya-praktikum.tech/api/v2/resources{{avatar}}"
      name="avatar"
      class="pr-avatar__img"
      alt="Аватар"
    />
  {{/if}}
</div>