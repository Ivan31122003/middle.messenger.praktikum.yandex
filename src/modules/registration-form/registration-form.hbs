<form id="registration-form" class="registration-form">
  <h1 class="registration-form__title">Регистрация</h1>

  <div class="registration-form__email">
    {{> pr-input name="email" variant="field" placeholder="Почта"}}
  </div>

  <div class="registration-form__middle-field">
    {{> pr-input name="login" variant="field" placeholder="Логин" }}
  </div>

  <div class="registration-form__middle-field">
    {{> pr-input name="first_name" variant="field" placeholder="Имя" }}
  </div>

  <div class="registration-form__middle-field">
    {{> pr-input name="second_name" variant="field" placeholder="Фамилия" }}
  </div>

  <div class="registration-form__middle-field">
    {{> pr-input name="phone" variant="field" placeholder="Телефон" }}
  </div>

  <div class="registration-form__middle-field">
    {{> pr-input name="password" variant="field" placeholder="Пароль" type="password" }}
  </div>

  <div class="registration-form__middle-field">
    {{> pr-input name="repeat_password" variant="field" placeholder="Пароль (еще раз)" type="password" }}
  </div>

  <div class="registration-form__registration-button">
    {{> pr-button text="Зарегистрироваться"}}
  </div>

    <a class="registration-form__login-link" href="/login">
      Войти
    </a>
  </div>

</form>