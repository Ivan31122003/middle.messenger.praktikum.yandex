<form class="registration-form">
  
  <h1 class="registration-form__title">Регистрация</h1>

  <div class="registration-form__email">
    {{> pr-input variant="field" placeholder="Почта"}}
  </div>

  <div class="registration-form__middle-field registration-form__login">
    {{> pr-input variant="field" placeholder="Логин" }}
  </div>

  <div class="registration-form__middle-field registration-form__name">
    {{> pr-input variant="field" placeholder="Имя" }}
  </div>

  <div class="registration-form__middle-field registration-form__surname">
    {{> pr-input variant="field" placeholder="Фамилия" }}
  </div>

  <div class="registration-form__middle-field registration-form__phone">
    {{> pr-input variant="field" placeholder="Телефон" }}
  </div>

  <div class="registration-form__middle-field registration-form__password">
    {{> pr-input variant="field" placeholder="Пароль" type="password" }}
  </div>

  <div class="registration-form__middle-field registration-form__password-repeat">
    {{> pr-input variant="field" placeholder="Пароль (еще раз)" type="password" }}
  </div>

  <div class="registration-form__registration-button">
    {{> pr-button text="Зарегистрироваться"}}
  </div>

    <a class="registration-form__login-link" href="/login">
      Войти
    </a>
  </div>

</form>