{{#> profile-layout}}
  <form id="profile-change-password-form" class="profile-change-password-form">
    {{> pr-avatar avatar=avatar}}
    <div class="profile-change-password-form__fields">
      <div class="profile-change-password-form__field-wrapper">
        {{> pr-input id="profile-change-password-form__old-password" name="old_password" variant="field" placeholder="Старый пароль" type="password" }}
      </div>
      <div class="profile-change-password-form__field-wrapper">
        {{> pr-input id="profile-change-password-form__new-password" name="new_password" variant="field" placeholder="Новый пароль" type="password" }}
      </div>
      <div class="profile-change-password-form__field-wrapper">
        {{> pr-input id="profile-change-password-form__repeat-new-password" name="repeat-new-password" variant="field" placeholder="Повторите новый пароль" type="password" }}
      </div>
    </div>
    <div class="profile-change-password-form__button-wrapper">
      {{> pr-button type="submit" text="Сохранить"}}
    </div>
  </form>
{{/profile-layout}}