<section class="chat">
  {{#with activeChat}}
    <header class="chat-header chat__header">
      <div class="chat-header__contact">
        <div class="chat-header__avatar"></div>
        <span>{{title}}</span>
      </div>
      
      <div class="chat-menu">
        {{{PrButton
          id="chat-menu-toggle"
          variant="icon"
          type="button"
          iconSrc="/assets/icons/three-dots.svg"
        }}}

        {{#if ../menuOpen}}
          <div class="chat-menu__dropdown">
            {{{PrButton
              id="chat-add-user"
              type="button"
              text="Добавить пользователя"
            }}}

            {{{PrButton
              id="chat-delete"
              type="button"
              text="Удалить пользователя"
            }}}
          </div>
        {{/if}}
      </div>
    </header>
  {{/with}}

  <hr class="chat__separator" />

  <div class="chat__communication">
    {{{ChatConversation conversation=conversation}}}
  </div>

  <hr class="chat__separator" />

  <div class="write chat__write">
    {{{ChatWriteForm}}}
  </div>
</section>