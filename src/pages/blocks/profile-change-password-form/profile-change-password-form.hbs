{{#with user}}
  <form id="profile-change-password-form" class="profile-change-password-form">
    {{{PrAvatar avatar=avatar}}}
    <div class="profile-change-password-form__fields">
      <div class="profile-change-password-form__field-wrapper">
        {{{PrInput
          ref="old_password"
          id="profile-change-password-form__old-password"
          name="old_password"
          variant="field"
          placeholder="Старый пароль"
          type="password"
        }}}
      </div>
      <div class="profile-change-password-form__field-wrapper">
        {{{PrInput
          ref="password"
          id="profile-change-password-form__new-password"
          name="password"
          variant="field"
          placeholder="Новый пароль"
          type="password"
        }}}
      </div>
      <div class="profile-change-password-form__field-wrapper">
        {{{PrInput
          ref="repeat_password"
          id="profile-change-password-form__repeat-new-password"
          name="repeat_password"
          variant="field"
          placeholder="Повторите новый пароль"
          type="password"
        }}}
      </div>
    </div>
    <div class="profile-change-password-form__button-wrapper">
      {{{PrButton type="submit" text="Сохранить"}}}
    </div>
  </form>
{{/with}}