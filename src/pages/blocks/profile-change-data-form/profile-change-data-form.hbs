{{#with user}}
  <form id="profile-change-data-form" class="profile-change-data-form">
    {{{ PrAvatar avatar=avatar }}}
    <div class="profile-change-data-form__fields">
      {{#each ../fields}}
        <div class="profile-change-data-form__field-wrapper">
          {{{ PrInput ref=name id=(concat 'profile-change-data-form__' name) name=name variant="field" placeholder=caption value=(lookup ../this key)}}}
        </div>
      {{/each}}
    </div>
    <div class="profile-change-data-form__button-wrapper">
      {{{ PrButton type="submit" text="Сохранить"}}}
    </div>
  </form>
{{/with}}
